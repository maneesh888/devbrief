<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.maneesh.devbrief.daily</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/devbrief</string>
        <string>generate</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>19</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/.devbrief/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.devbrief/launchd.err.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
